---
// Shield mascot — a friendly little character (PostHog-mascot energy) drawn in
// different poses. Body + face + limbs + feet, with per-pose expression.
// Decorative & animated with CSS only (strict CSP).
import "../shield.css";

interface Props {
  pose?: string;
  size?: number;
  float?: boolean;
  label?: string;
}
const { pose = "wave", size = 96, float = false, label } = Astro.props;
const a11y = label
  ? { role: "img", "aria-label": label }
  : { "aria-hidden": "true" };
const cls = `shield shield-${pose}${float ? " floating" : ""}`;
---

<svg class={cls} viewBox="-16 -12 80 84" width={size} height={size} focusable="false" {...a11y}>
  <!-- Core character: feet, body, cel-shading, chest emblem, eyes. -->
  <g class="shield-core">
    <ellipse class="shield-foot foot-l" cx="16" cy="50" rx="4.5" ry="3" />
    <ellipse class="shield-foot foot-r" cx="32" cy="50" rx="4.5" ry="3" />
    <path class="shield-body" d="M24 1.5 Q40 1.5 44 10 Q45 32 24 53 Q3 32 4 10 Q8 1.5 24 1.5 Z" />
    <path class="shield-shade" d="M8 33 Q24 48 40 33 Q44 43 24 53 Q4 43 8 33 Z" />
    <ellipse class="shield-sheen" cx="15" cy="13" rx="7.5" ry="4.5" />
    <circle class="shield-eye" cx="18" cy="20" r="5.6" />
    <circle class="shield-eye" cx="30" cy="20" r="5.6" />
    <circle class="shield-pupil" cx="18" cy="20.5" r="2.7" />
    <circle class="shield-pupil" cx="30" cy="20.5" r="2.7" />
    <circle class="shield-glint" cx="16.7" cy="18.6" r="1.05" />
    <circle class="shield-glint" cx="28.7" cy="18.6" r="1.05" />
  </g>

  {pose !== "lock" && (
    <g class="shield-emblem">
      <circle class="emblem-disc" cx="24" cy="42" r="5" />
      <circle class="emblem-key" cx="24" cy="41" r="1.7" />
      <rect class="emblem-key" x="23.2" y="41" width="1.6" height="4" rx="0.6" />
    </g>
  )}

  {pose === "wave" && (
    <g class="shield-extra">
      <path class="brow" d="M13.5 13.5 Q18 11.5 22 13.5" />
      <path class="brow" d="M26 13.5 Q30 11.5 34.5 13.5" />
      <path class="mouth-open" d="M18 27 Q24 29 30 27 Q27 34 24 34 Q21 34 18 27 Z" />
      <path class="shield-arm" d="M7 33 Q2 37 1 42" />
      <circle class="shield-hand" cx="1" cy="42" r="2.8" />
      <g class="wave-arm">
        <path class="shield-arm" d="M41 28 Q50 20 52 12" />
        <circle class="shield-hand" cx="52" cy="12" r="3.1" />
      </g>
    </g>
  )}

  {pose === "lookup" && (
    <g class="shield-extra">
      <path class="brow" d="M13.5 14 Q18 12.5 22 13.5" />
      <path class="brow brow-raised" d="M26 11.5 Q30 9.5 34.5 12.5" />
      <ellipse class="mouth-o" cx="24" cy="29" rx="2.2" ry="2.7" />
      <path class="shield-arm" d="M41 27 Q47 26 49 30" />
      <g class="mg">
        <circle class="mg-lens" cx="50" cy="22" r="7.5" />
        <line class="mg-handle" x1="55.3" y1="27.3" x2="61" y2="33" />
      </g>
    </g>
  )}

  {pose === "work" && (
    <g class="shield-extra">
      <path class="hat-dome" d="M13 9 Q13 -3 24 -3 Q35 -3 35 9 Z" />
      <rect class="hat-brim" x="8" y="7.5" width="32" height="4.6" rx="2.2" />
      <rect class="hat-ridge" x="22.5" y="-3" width="3" height="11" rx="1.2" />
      <path class="brow" d="M13.5 14 L21 14" />
      <path class="brow" d="M27 14 L34.5 14" />
      <path class="mouth" d="M19 29 Q24 31.5 29 29" />
      <path class="shield-arm" d="M42 32 L48 37" />
      <rect class="clip-board" x="47" y="34" width="16" height="20" rx="1.5" />
      <rect class="clip-top" x="52" y="31" width="6" height="4" rx="1" />
      <line class="clip-line" x1="50.5" y1="42" x2="59.5" y2="42" />
      <line class="clip-line" x1="50.5" y1="46" x2="59.5" y2="46" />
      <line class="clip-line" x1="50.5" y1="50" x2="56.5" y2="50" />
    </g>
  )}

  {pose === "shrug" && (
    <g class="shield-extra">
      <path class="brow" d="M13.5 12.5 Q18 11.5 22 14.5" />
      <path class="brow" d="M26 14.5 Q30 11.5 34.5 12.5" />
      <path class="mouth" d="M18 30 Q21 28 24 30 Q27 32 30 30" />
      <path class="shield-arm" d="M7 32 Q0 30 -3 24" />
      <circle class="shield-hand" cx="-3" cy="24" r="2.8" />
      <path class="shield-arm" d="M41 32 Q48 30 51 24" />
      <circle class="shield-hand" cx="51" cy="24" r="2.8" />
      <text class="shrug-q" x="41" y="4" text-anchor="middle">?</text>
    </g>
  )}

  {pose === "lock" && (
    <g class="shield-extra">
      <path class="brow" d="M13.5 13.5 Q18 12 22 13.5" />
      <path class="brow" d="M26 13.5 Q30 12 34.5 13.5" />
      <path class="mouth" d="M18 28 Q24 33 30 28" />
      <path class="shield-arm" d="M9 33 Q14 44 20 41" />
      <path class="shield-arm" d="M39 33 Q34 44 28 41" />
      <path class="lock-shackle" d="M20 40 V35 Q20 30 24 30 Q28 30 28 35 V40" />
      <rect class="lock-body" x="17" y="39.5" width="14" height="11" rx="1.8" />
      <circle class="lock-hole" cx="24" cy="44" r="1.7" />
      <rect class="lock-hole" x="23.2" y="44" width="1.6" height="4" rx="0.6" />
    </g>
  )}

  {pose === "peek" && (
    <g class="shield-extra">
      <path class="brow" d="M13.5 14 Q18 12.5 22 13.5" />
      <path class="brow brow-raised" d="M26 12 Q30 10.5 34.5 13" />
      <path class="mouth" d="M19 28.5 Q24 31.5 29 28.5" />
      <rect class="peek-edge" x="-16" y="40" width="80" height="32" />
      <rect class="grip" x="11.5" y="37" width="7.5" height="6.5" rx="2.2" />
      <rect class="grip" x="29" y="37" width="7.5" height="6.5" rx="2.2" />
    </g>
  )}
</svg>
