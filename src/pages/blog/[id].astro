---
import { getCollection, render } from "astro:content";
import Base from "../../layouts/Base.astro";
import { site } from "../../site";

export async function getStaticPaths() {
  const posts = await getCollection("blog");
  return posts.map((post) => ({ params: { id: post.id }, props: { post } }));
}

const { post } = Astro.props;
const { Content } = await render(post);
---

<Base title={`${post.data.title} — ${site.name}`}>
  <article class="prose">
    <a class="back" href="/blog/">‹ Blog</a>
    <time class="eyebrow" datetime={post.data.date.toISOString()}>{post.data.date.toLocaleDateString("en-US", { dateStyle: "long" })}</time>
    <h1>{post.data.title}</h1>
    <p class="lead">{post.data.description}</p>
    <Content />
  </article>
</Base>
