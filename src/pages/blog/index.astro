---
import { getCollection } from "astro:content";
import Base from "../../layouts/Base.astro";
import { site } from "../../site";

const posts = (await getCollection("blog")).sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
---

<Base title={`Blog — ${site.name}`}>
  <section class="hero">
    <h1>Blog.</h1>
    <p class="lead">Practical security, in plain English.</p>
  </section>
  <section class="band band-gray">
    <div class="tiles">
      {posts.map((p) => (
        <a class="tile tile-link" href={`/blog/${p.id}/`}>
          <time class="eyebrow" datetime={p.data.date.toISOString()}>{p.data.date.toLocaleDateString("en-US", { dateStyle: "long" })}</time>
          <h3>{p.data.title}</h3>
          <p>{p.data.description}</p>
        </a>
      ))}
    </div>
  </section>
</Base>
