---
import { getCollection } from "astro:content";
import Base from "../../layouts/Base.astro";
import { site } from "../../site";
import { getSubstackPosts } from "../../substack";

const local = (await getCollection("blog")).map((p) => ({
  title: p.data.title,
  description: p.data.description,
  date: p.data.date,
  url: `/blog/${p.id}/`,
  external: false,
}));
const substack = (await getSubstackPosts()).map((p) => ({ ...p, external: true }));
const posts = [...local, ...substack].sort((a, b) => b.date.valueOf() - a.date.valueOf());
const fmt = (d: Date) => d.toLocaleDateString("en-US", { dateStyle: "long" });
---

<Base title={`Blog — ${site.name}`}>
  <section class="hero stagger">
    <h1>Blog.</h1>
    <p class="lead">Practical security, in plain English.</p>
    <div class="ctas">
      <a class="pill" href={site.substack.profile} rel="noopener noreferrer">Subscribe on Substack</a>
    </div>
  </section>
  <section class="band band-gray">
    <div class="tiles stagger">
      {posts.map((p) => (
        <a class="tile tile-link" href={p.url} rel={p.external ? "noopener noreferrer" : undefined}>
          <span class="eyebrow">
            <time datetime={p.date.toISOString()}>{fmt(p.date)}</time>{p.external && " · Substack ↗"}
          </span>
          <h3>{p.title}</h3>
          <p>{p.description}</p>
        </a>
      ))}
    </div>
  </section>
</Base>
