---
import Base from "../layouts/Base.astro";
import Shield from "../components/Shield.astro";
---

<Base title="Page not found">
  <section class="hero stagger">
    <div class="hero-shield"><Shield pose="shrug" size={140} label="Shield shrugging" /></div>
    <h1>Page not found.</h1>
    <p class="lead">The page you're looking for doesn't exist.</p>
    <div class="ctas"><a class="pill" href="/">Back home</a> <a class="more" href="/">Try the glossary</a></div>
  </section>
</Base>
