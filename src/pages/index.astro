---
import Base from "../layouts/Base.astro";
import { site } from "../site";
import { getAllPosts, formatDate } from "../posts";

const latest = (await getAllPosts()).slice(0, 3);

---

<Base title={`${site.name} — ${site.role}`}>
  <section class="hero stagger">
    <p class="eyebrow">{site.role}</p>
    <h1>{site.headline.split("\n").map((line) => <span>{line}</span>)}</h1>
    <p class="lead">{site.tagline}</p>
    <div class="ctas">
      <a class="pill" href={`mailto:${site.email}`}>Get in touch</a>
      <a class="more" href="#services">See services</a>
    </div>
  </section>

  <section class="band band-gray stats-band">
    <div class="stats">
      <a class="stat" href="/about/#certifications"><span class="stat-value">{site.certifications.length}</span><span class="stat-label">certifications: AWS, Azure, CompTIA</span></a>
      {site.highlights.map((h) => <div class="stat"><span class="stat-value">{h.value}</span><span class="stat-label">{h.label}</span></div>)}
    </div>
  </section>

  <section class="band">
    <div class="narrow reveal">
      <h2>No jargon. No scare tactics.</h2>
      {site.about.map((p) => <p class="body-lg">{p}</p>)}
      <a class="more" href="/about/">My story so far</a>
    </div>
  </section>

  <section id="services" class="band band-gray">
    <h2 class="center reveal">What I can do for you.</h2>
    <div class="tiles">
      {site.services.map((s) => (
        <article class="tile reveal">
          <h3>{s.title}</h3>
          <p>{s.text}</p>
        </article>
      ))}
    </div>
    <p class="center"><a class="pill" href="/features/">Explore 15 areas of security →</a></p>
  </section>

  <section class="band">
    <h2 class="center reveal">How it works.</h2>
    <ol class="steps">
      {site.process.map((p) => (
        <li class="step reveal">
          <span class="step-num">{p.step}</span>
          <h3>{p.title}</h3>
          <p>{p.text}</p>
        </li>
      ))}
    </ol>
  </section>

  <section id="project" class="band band-dark">
    <div class="narrow center reveal">
      <p class="eyebrow">Project</p>
      <h2>{site.project.title}.<br />Hardened by design.</h2>
      <p class="body-lg">{site.project.text}</p>
      <div class="checks">
        {site.project.checks.map((c) => <a class="more" href={c.url} rel="noopener noreferrer">{c.label}</a>)}
      </div>
    </div>
  </section>

  <section class="band band-gray">
    <h2 class="center reveal">Latest writing.</h2>
    <div class="tiles">
      {latest.map((p) => (
        <a class="tile tile-link reveal" href={p.url} rel={p.external ? "noopener noreferrer" : undefined}>
          <span class="eyebrow">{formatDate(p.date)}{p.external && " · Substack ↗"}</span>
          <h3>{p.title}</h3>
          <p>{p.description}</p>
        </a>
      ))}
    </div>
    <p class="center"><a class="more" href="/blog/">All posts</a></p>
  </section>

  <section id="contact" class="band">
    <div class="narrow center reveal">
      <h2>Let's talk.</h2>
      <p class="body-lg">Tell me briefly what you need and I'll reply within a couple of days.</p>
      <div class="ctas">
        <a class="pill" href={`mailto:${site.email}`}>{site.email}</a>
        {site.links.map((l) => <a class="more" href={l.url} rel="noopener noreferrer">{l.label}</a>)}
      </div>
      {site.pgp.file && <p class="small">Sensitive? Encrypt with my <a href={site.pgp.file}>PGP key</a>.</p>}
      <p class="small">Found a security issue on this site? <a href="/security">Report it responsibly</a>.</p>
    </div>
  </section>
</Base>
