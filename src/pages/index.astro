---
import Base from "../layouts/Base.astro";
import { site } from "../site";
---

<Base title={`${site.name} — ${site.role}`}>
  <header class="hero">
    <p class="eyebrow">{site.role}</p>
    <h1>{site.name}</h1>
    <p class="lead">{site.tagline}</p>
    <a class="button" href={`mailto:${site.email}`}>Get in touch</a>
  </header>

  <section>
    <h2>About</h2>
    {site.about.map((p) => <p>{p}</p>)}
  </section>

  <section>
    <h2>Services</h2>
    <div class="cards">
      {site.services.map((s) => (
        <article class="card">
          <h3>{s.title}</h3>
          <p>{s.text}</p>
        </article>
      ))}
    </div>
  </section>

  <section>
    <h2>Project: {site.project.title}</h2>
    <p>{site.project.text}</p>
    <ul class="links">
      {site.project.checks.map((c) => <li><a href={c.url} rel="noopener noreferrer">{c.label}</a></li>)}
    </ul>
  </section>

  <section>
    <h2>Contact</h2>
    <p>Tell me briefly what you need and I'll reply within a couple of days.</p>
    <ul class="links">
      <li><a href={`mailto:${site.email}`}>{site.email}</a></li>
      {site.links.map((l) => <li><a href={l.url} rel="noopener noreferrer">{l.label}</a></li>)}
    </ul>
  </section>
</Base>
